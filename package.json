{
  "name": "react-m3-mobile-skeleton",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html,json}\"",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "db:backup": "node script/backupToGoogleSheets.js",
    "db:clean": "node script/cleanAllRecords.js",
    "db:migrate": "node script/migrateFromSheets.js",
    "db:merge": "node script/mergeCustomersFromSheets.js",
    "deploy": "firebase deploy --only hosting",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "bump": "changeset version"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.6.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "googleapis": "^181.0.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.21.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/parser": "^8.25.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-tools": "^13.31.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{css,html,json}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=25.0.0",
    "npm": ">=10.0.0"
  }
}
